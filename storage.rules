rules_version = '2';

// CoreFlow — Firebase Storage 보안 규칙 (참고용 기본값)
// 배포:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // firestore.rules 의 isMember()/isAdmin() 과 동일한 판정을 Storage
    // 쪽에서도 쓰기 위한 대응 함수 — Storage 규칙은 firestore.get()/exists()
    // 로 Firestore 문서를 조회할 수 있습니다. 구성원 = users/{본인}이 있고
    // status 가 ACTIVE (초대 없이 Auth 계정만 만든 외부인·승인 대기·정지
    // 계정 제외).
    function isMember() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
             .data.get('status', null) == 'ACTIVE';
    }

    function isAdmin() {
      return isMember()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
             .data.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    // users/{uid}/profile.*  ·  users/{uid}/signature.*
    match /users/{uid}/{fileName} {
      // 프로필 이미지·서명은 로그인 사용자면 조회 가능 — firestore.rules의
      // users 컬렉션(get/list: isMember())과 동일하게 조직도·전자결재
      // PDF에 타인의 서명을 렌더링해야 해서 사내 전체 공개가 의도된 동작.
      // 본인 파일은 가입 직후(users 문서 생성 전) 업로드하고 곧바로
      // getDownloadURL 로 읽으므로 구성원이 아니어도 허용합니다.
      allow read: if isMember() || (isSignedIn() && request.auth.uid == uid);

      // 본인만 업로드/수정/삭제, 5MB 이하 이미지로 제한
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // approvals/{no}/{owner}/*  — 전자결재 첨부파일 (owner = 업로더 uid)
    //
    // 첨부는 결재 문서 생성보다 먼저 올라갑니다(approval/new 에서 문서번호만
    // 먼저 만들고 파일부터 올린 뒤, 상신 때 문서를 생성). 예전엔 경로가
    // approvals/{no}/{파일} 이라 "문서가 아직 없으면 구성원 누구나 읽기/쓰기"
    // 였고, 문서번호(날짜+밀리초 끝 4자리)를 추측하면 남이 작성 중인 기안의
    // 첨부를 읽거나 파일을 끼워 넣을 수 있었습니다. 업로더 uid 폴더를 두어
    // 문서가 생기기 전엔 본인 폴더만 접근하게 합니다.
    match /approvals/{no}/{owner}/{fileName} {
      // firestore.rules 의 approvals 문서 read 정책(기안자·결재라인
      // (approverUids)·관리자만 열람)과 동일 기준.
      function approvalExists() {
        return firestore.exists(/databases/(default)/documents/approvals/$(no));
      }
      function isApprovalMember() {
        let ap = firestore.get(/databases/(default)/documents/approvals/$(no));
        return ap.data.authorUid == request.auth.uid
          || ap.data.currentApproverUid == request.auth.uid
          || request.auth.uid in ap.data.get('approverUids', []);
      }

      allow read: if isMember()
        && (approvalExists()
            ? (isApprovalMember() || isAdmin())
            : owner == request.auth.uid);

      // 쓰기는 항상 본인 폴더만, 문서가 이미 있으면 기안자 본인(또는 관리자)만.
      allow write: if isMember()
        && owner == request.auth.uid
        && request.resource.size < 20 * 1024 * 1024
        && (!approvalExists()
            || firestore.get(/databases/(default)/documents/approvals/$(no)).data.authorUid == request.auth.uid
            || isAdmin());
    }

    // 업로더 폴더 도입 전의 첨부(approvals/{no}/{파일}) — 기존 문서에 링크된
    // 파일 열람만 남겨둡니다. 새 업로드는 위 경로로만.
    match /approvals/{no}/{fileName} {
      allow read: if isMember()
        && firestore.exists(/databases/(default)/documents/approvals/$(no))
        && (firestore.get(/databases/(default)/documents/approvals/$(no)).data.authorUid == request.auth.uid
            || firestore.get(/databases/(default)/documents/approvals/$(no)).data.currentApproverUid == request.auth.uid
            || request.auth.uid in firestore.get(/databases/(default)/documents/approvals/$(no)).data.get('approverUids', [])
            || isAdmin());
    }

    // chats/{chatId}/*  — 채팅 첨부파일/이미지
    match /chats/{chatId}/{fileName} {
      // firestore.rules 의 chats 문서(memberIds 소속자만 read/write)와
      // 동일하게 좁힘 — 예전에는 로그인만 하면 전사 누구나 다른 사람의
      // 채팅방 첨부파일을 경로만 알면 읽고 쓸 수 있었던 불일치를 해소.
      allow read: if isMember()
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in
             firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberIds;

      allow write: if isMember()
        && request.resource.size < 20 * 1024 * 1024
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in
             firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberIds;
    }
  }
}

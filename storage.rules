rules_version = '2';

// CoreFlow — Firebase Storage 보안 규칙 (참고용 기본값)
// 배포:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // firestore.rules 의 isAdmin() 과 동일한 판정을 Storage 쪽에서도 쓰기
    // 위한 대응 함수 — Storage 규칙은 firestore.get()/exists() 로 Firestore
    // 문서를 조회할 수 있습니다.
    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
             .data.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    // users/{uid}/profile.*  ·  users/{uid}/signature.*
    match /users/{uid}/{fileName} {
      // 프로필 이미지·서명은 로그인 사용자면 조회 가능 — firestore.rules의
      // users 컬렉션(get/list: isSignedIn())과 동일하게 조직도·전자결재
      // PDF에 타인의 서명을 렌더링해야 해서 사내 전체 공개가 의도된 동작.
      allow read: if isSignedIn();

      // 본인만 업로드/수정/삭제, 5MB 이하 이미지로 제한
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // approvals/{no}/*  — 전자결재 첨부파일
    match /approvals/{no}/{fileName} {
      // firestore.rules 의 approvals 문서 read 정책(기안자·결재라인
      // (approverUids)·관리자만 열람)과 동일 기준. approverUids 필드가
      // 없는(이 필드 도입 전에 생성된) 구 문서는 authorUid/
      // currentApproverUid 로만 판정됩니다.
      function isApprovalMember() {
        let ap = firestore.get(/databases/(default)/documents/approvals/$(no));
        return ap.data.authorUid == request.auth.uid
          || ap.data.currentApproverUid == request.auth.uid
          || request.auth.uid in ap.data.get('approverUids', []);
      }

      // 첨부 업로드/다운로드가 결재 문서 생성보다 먼저 일어나는 흐름이
      // 있어(approval/new 페이지에서 문서번호만 먼저 만들고 파일부터
      // 올린 뒤 getDownloadURL 로 바로 읽고, 그 다음에야 문서를 생성)
      // 그 문서(no)가 아직 Firestore에 없는 동안만 예외적으로 로그인
      // 사용자면 읽기/쓰기 가능 — 존재하는 순간부터는 관련자만.
      allow read: if isSignedIn()
        && (
          !firestore.exists(/databases/(default)/documents/approvals/$(no))
          || isApprovalMember()
          || isAdmin()
        );

      // 업로드도 동일 기준: 문서가 아직 없으면(작성 중) 로그인 사용자면
      // 허용, 이미 존재하면 기안자 본인 또는 관리자만 — 이미 존재하는
      // 남의 결재 폴더에 파일을 끼워 넣는 것은 차단.
      allow write: if isSignedIn()
        && request.resource.size < 20 * 1024 * 1024
        && (
          !firestore.exists(/databases/(default)/documents/approvals/$(no))
          || firestore.get(/databases/(default)/documents/approvals/$(no)).data.authorUid == request.auth.uid
          || isAdmin()
        );
    }

    // chats/{chatId}/*  — 채팅 첨부파일/이미지
    match /chats/{chatId}/{fileName} {
      // firestore.rules 의 chats 문서(memberIds 소속자만 read/write)와
      // 동일하게 좁힘 — 예전에는 로그인만 하면 전사 누구나 다른 사람의
      // 채팅방 첨부파일을 경로만 알면 읽고 쓸 수 있었던 불일치를 해소.
      allow read: if isSignedIn()
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in
             firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberIds;

      allow write: if isSignedIn()
        && request.resource.size < 20 * 1024 * 1024
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in
             firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberIds;
    }
  }
}

rules_version = '2';

// CoreFlow — Firestore 보안 규칙 (참고용 기본값)
// 배포:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /* 실제 구성원 = users/{본인} 문서가 있고 status 가 ACTIVE. Firebase Auth
       가입은 공개 API 키만 있으면 누구나 할 수 있어서(초대 없이도 계정 생성
       가능), 예전처럼 "로그인만 하면" 허용하면 초대받지 않은 외부인도 직원
       디렉터리(전화번호·이메일)·Task·일정·공지를 전부 읽을 수 있었고,
       관리자 승인 전(PENDING)·정지(SUSPENDED) 계정도 마찬가지였습니다.
       공용 데이터는 전부 이 함수로 판정합니다. 가입·로그인·2FA·세션처럼
       구성원이 되기 전에도 본인 데이터에 접근해야 하는 경로만 isSignedIn()
       을 씁니다. */
    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', null) == 'ACTIVE';
    }

    function isAdmin() {
      return isMember()
        && myRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    /* 전자결재 휴가신청서(approvals/{id})가 실제로 최종 승인됐고, 그 기안자가
       uid 본인일 때만 true — leaves/{id}(문서번호를 그대로 id로 재사용) 승인
       생성을 이 사실에 근거해서만 허용하기 위한 헬퍼. 결재자(제3자)가 본인이
       아닌 uid 로 leaves 문서를 만드는 유일한 합법 경로입니다. */
    // 생성하려는 leaves 문서(d)의 기간·일수·종류도 결재 문서의 leaveRequest와
    // 같아야 합니다 — 그렇지 않으면 1일짜리로 승인받은 뒤 leaves 문서는
    // 10일로 만들어도 통과했습니다.
    function isApprovedLeaveApproval(id, d) {
      let ap = get(/databases/$(database)/documents/approvals/$(id));
      return ap.data.status == 'Approved'
        && ap.data.type == '휴가'
        && ap.data.authorUid == d.uid
        && d.kind == ap.data.leaveRequest.kind
        && d.start == ap.data.leaveRequest.start
        && d.end == ap.data.leaveRequest.end
        && d.days == ap.data.leaveRequest.days;
    }

    /* ---------------- users/{uid} ----------------
       조직도 · 태스크 담당자 검색 · 결재자 검색 등이 전부 이 컬렉션을 단일
       소스로 씁니다 — orgPeople 처럼 로그인 사용자면 누구나 조회 가능해야
       합니다(사내 디렉터리). 가계정(미입사)은 users/{placeholder-<random>}
       로 존재하며 관리자만 생성/삭제할 수 있습니다. */
    match /users/{uid} {
      // 본인 문서는 구성원이 되기 전(승인 대기·정지)에도 읽을 수 있어야
      // 로그인 화면·AuthGuard가 상태를 보고 안내할 수 있습니다.
      allow get: if isMember() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isMember();

      // 가입 시: 본인 uid 로만 문서 생성, 권한은 스스로 승격 불가. teamId·
      // managerId 는 초대장에 관리자가 미리 박아둔 값과 일치해야만 통과
      // (본인이 스스로 팀/상사를 임의로 지정해 배정을 우회하는 것 방지).
      // 참조하는 초대장은 반드시 "내 이메일로 발급된, 아직 쓰지 않은, 만료
      // 전" 초대장이어야 합니다 — 이 검증이 없으면 남의(예: ADMIN) 초대장
      // id만 알아도 그걸 inviteId로 걸어 그 role로 가입할 수 있었습니다.
      // (get()은 같은 배치의 invites COMPLETED 갱신 "이전" 상태를 봅니다.)
      allow create: if (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.email
             == request.auth.token.email
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.status
             != 'COMPLETED'
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.expiresAt
             > request.time
          // 승인 필요 초대면 PENDING, 아니면 ACTIVE 로만 — 예전엔 둘 중
          // 아무거나 허용돼 관리자 승인이 필요한 초대도 ACTIVE 로 곧장
          // 가입해 승인 절차를 건너뛸 수 있었습니다.
          && request.resource.data.status
             == (get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.get('requireApproval', false) == true
                 ? 'PENDING' : 'ACTIVE')
          // 사번·직급도 초대장 값 그대로 — 본인 update 규칙이 employeeId 를
          // 고정하는데 create 때 임의 사번(혹은 '대표' 같은 직급)을 넣으면
          // 그 값이 그대로 굳어버립니다.
          && request.resource.data.employeeId
             == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.employeeId
          && request.resource.data.position
             == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.position
          && request.resource.data.teamId
             == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.teamId
          && request.resource.data.managerId
             == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.managerId
          // role도 teamId·managerId와 동일하게 초대장 값과 일치해야 합니다 —
          // 이 검증이 없으면 가입 시 role:'SUPER_ADMIN'을 직접 써 넣어
          // 스스로 최고 관리자 권한을 획득할 수 있었습니다(update 규칙은
          // role 불변을 강제하지만 create 시점엔 아무 제약이 없었음).
          && request.resource.data.role
             == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.role)
        || (isAdmin()
            && uid.matches('^placeholder-.*')
            && request.resource.data.status == 'PLACEHOLDER');

      // 본인은 프로필 일부만 수정 — 상태/권한/사번/팀/상사/이메일 변경은
      // 관리자만 (가계정 편집도 이 update 경로로 처리되며 isAdmin() 이
      // 커버합니다). email은 create 시 auth 토큰과 일치하도록 고정되므로
      // update에서도 그대로 유지되게 막지 않으면, 본인 계정으로 로그인한
      // 채 users 문서의 email만 바꿔 조직도·설정 화면에 다른 사람 이메일로
      // 표시되게 할 수 있었습니다.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.employeeId == resource.data.employeeId
            && request.resource.data.teamId == resource.data.teamId
            && request.resource.data.managerId == resource.data.managerId
            && request.resource.data.email == resource.data.email);

      allow delete: if isAdmin();
    }

    /* ---------------- userSecrets/{uid} (2FA 비밀키 · 백업코드 해시) ----------------
       TOTP는 서버 없이 클라이언트에서 검증하므로 비밀키를 평문으로 둘 수밖에
       없는데(totp.ts 참고), 예전엔 이 값이 users/{uid} 안에 있었습니다.
       users는 조직도·결재자 검색용 사내 디렉터리라 로그인한 누구나 조회
       가능해서(get, list: 구성원 전체), 다른 직원이 피해자의 users 문서를
       그냥 읽어 TOTP 비밀키를 그대로 가져가 2FA를 완전히 우회할 수
       있었습니다. 본인만 read/write 가능한 이 컬렉션으로 분리해 막습니다.
       관리자도 예외 없이 열람 불가(비밀값은 관리자도 볼 이유가 없음) —
       계정 접근이 막히면 users 삭제처럼 관리자가 users 문서 자체를 정리하는
       경로로 처리합니다. */
    match /userSecrets/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    /* ---------------- teams/{id} (부서/팀 편제) ---------------- */
    match /teams/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    /* ---------------- 그룹웨어 공용 컬렉션 ---------------- */
    match /notices/{id} {
      // draft(임시저장)는 작성자 본인 또는 관리자만 — 예전엔 "로그인만
      // 하면 허용"이라 다른 사람의 임시저장 공지도 전역 검색·URL 직접
      // 접속으로 읽을 수 있었습니다. status 필드 자체가 없는 문서는(이제
      // addNotice/buildSeed가 항상 채우므로 정상 경로로는 생기지 않음)
      // 작성자·관리자가 아니면 보이지 않습니다(열림 실패 쪽으로 안전하게
      // 막힘) — useNoticeCollection의 where("status","!=","draft") 쿼리와
      // 짝을 맞추기 위해 .get() 기본값을 쓰지 않습니다.
      allow read: if isAdmin()
        || (isMember() && resource.data.status != 'draft')
        || (isMember() && resource.data.authorUid == request.auth.uid);
      // authorUid는 반드시 본인 — 예전엔 검사가 없어 남의 uid를 authorUid로
      // 넣어 그 사람 이름으로 공지를 올릴 수 있었습니다. authorUid가 아예
      // 없는 문서(/admin/seed 의 데모 공지)는 관리자만 생성할 수 있습니다.
      allow create: if isMember()
        && (request.resource.data.get('authorUid', null) == request.auth.uid
            || (isAdmin() && !('authorUid' in request.resource.data)));
      // 작성자가 아닌 사람은 열람·댓글이 남기는 카운터만 갱신 가능: 조회수
      // +1, 댓글 수 ±1, 본인 uid를 readByUids에 추가. 예전엔 "title/body/
      // cat/pinned/status가 그대로면 허용"이라 나머지 필드(authorUid 포함)는
      // 아무나 바꿀 수 있었고, authorUid를 자기 uid로 바꾸는 순간 그 공지의
      // 작성자가 되어 내용 수정·삭제까지 전부 가능했습니다. 실제 내용
      // 수정·삭제는 예외 없이 작성자 본인만 가능(관리자도 불가).
      allow update: if isMember()
        && (
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['views', 'comments', 'readByUids'])
            && request.resource.data.get('views', 0) in
                 [resource.data.get('views', 0), resource.data.get('views', 0) + 1]
            && request.resource.data.get('comments', 0) in
                 [resource.data.get('comments', 0) - 1,
                  resource.data.get('comments', 0),
                  resource.data.get('comments', 0) + 1]
            // readByUids(사용자별 읽음 기록)는 본인 uid를 추가하는 것만
            // 허용 — 그렇지 않으면 열람한 아무나가 남의 uid를 넣어(안
            // 읽었는데 읽음 처리) 또는 빼서(다시 안읽음으로) 남의 열람
            // 상태를 조작할 수 있습니다.
            && request.resource.data.get('readByUids', []).hasAll(resource.data.get('readByUids', []))
            && resource.data.get('readByUids', []).concat([request.auth.uid])
                 .hasAll(request.resource.data.get('readByUids', [])))
          || (resource.data.get('authorUid', null) == request.auth.uid
              && request.resource.data.authorUid == resource.data.authorUid)
        );
      allow delete: if isMember()
        && resource.data.authorUid == request.auth.uid;

      /* 공지 댓글 — notices/{id}/comments/{cid} */
      match /comments/{cid} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.uid == request.auth.uid;
        // 수정은 작성자 본인만, 수정 후에도 uid는 그대로여야 합니다(공지·
        // Task·결재 댓글, 채팅 메시지 senderId 모두 동일) — 그렇지 않으면 내
        // 댓글을 고치면서 uid를 다른 직원으로 바꿔 그 사람이 쓴 것처럼 만들 수
        // 있었습니다. 삭제는 작성자 본인이거나 관리자/최상위
        // 관리자(admin/super_admin)도 가능 — 타인 댓글을 정리할 수 있도록.
        allow update: if isMember()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isMember()
          && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }
    /* ---------------- tasks/{id} (칸반) ----------------
       예전엔 로그인만 하면 누구 카드든 수정·삭제할 수 있었습니다.
       - 생성: createdBy == 본인 (시드 데이터처럼 createdBy 없는 카드는 관리자만)
       - 내용·진행 상태 수정: 만든 사람·담당자(assigneeId)·관리자
       - 다른 구성원: 칸반 드래그가 같은 컬럼 카드들의 order 를 다시 매기므로
         order 만 변경 가능
       - 삭제: 만든 사람·관리자
       createdBy 가 없는 기존 카드는 담당자·관리자만 수정, 관리자만 삭제. */
    match /tasks/{id} {
      function isTaskOwner() {
        return resource.data.get('createdBy', null) == request.auth.uid
          || resource.data.get('assigneeId', null) == request.auth.uid;
      }
      allow read: if isMember();
      allow create: if isMember()
        && (request.resource.data.get('createdBy', null) == request.auth.uid
            || (isAdmin() && !('createdBy' in request.resource.data)));
      allow update: if isAdmin()
        || (isMember()
            && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
            && (isTaskOwner()
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['order'])));
      allow delete: if isAdmin()
        || (isMember() && resource.data.get('createdBy', null) == request.auth.uid);

      /* Task 댓글 — tasks/{id}/comments/{cid} (notices/{id}/comments 와 동일 정책) */
      match /comments/{cid} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.uid == request.auth.uid;
        allow update: if isMember()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isMember()
          && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }
    /* ---------------- approvals/{no} (전자결재) ----------------
       쓰기 경로는 세 가지뿐입니다.
       1) 기안자: 임시저장(bucket 'drafted') 상태인 동안만 내용을 고치거나
          상신할 수 있습니다. 상신 순간(=결재 차례가 생기는 순간)에는 결재
          순서(approverSeq/step)가 올바른지 검증합니다.
       2) 현재 결재자(currentApproverUid): 결재 진행 필드(status·line·
          currentApproverUid·step)만 바꿀 수 있고, 다음 결재자는 반드시
          approverSeq[step+1], 최종 승인은 마지막 단계에서만 가능합니다.
       3) 관리자.
       예전엔 "status·line이 그대로면 관련자 누구나 아무 필드나 수정"이라
       기안자가 currentApproverUid를 원하는 동료로 바꿔 결재선을 우회하거나
       type·leaveRequest를 고칠 수 있었고, 현재 결재자는 곧장
       status:'Approved'를 써서 뒤 결재자를 모두 건너뛸 수 있었습니다.

       열람은 기안자·결재라인(approverUids)·관리자만 — 운영 전환 시 전사
       공개 대신 이 문서와 관련 있는 사람만 보도록 좁히기로 한 결정.
       approverUids 필드가 추가되기 전에 생성된 문서는 이 필드가 없어
       authorUid/currentApproverUid 로만 판정됩니다(storage.rules 도 동일
       기준을 씀 — 첨부파일 다운로드만 따로 열려 있으면 이 좁히기가 무의미). */
    match /approvals/{no} {
      function isApprovalMember() {
        return resource.data.authorUid == request.auth.uid
          || resource.data.currentApproverUid == request.auth.uid
          || request.auth.uid in resource.data.get('approverUids', []);
      }

      // 기안자가 쓰는 문서(생성 또는 임시저장 수정)의 공통 조건. status는
      // 반드시 'Waiting' — 그렇지 않으면 처음부터 status:'Approved'로 문서를
      // 만들어 곧바로 isApprovedLeaveApproval()을 통과시킬 수 있었습니다.
      // 상신(bucket != 'drafted')이면 결재 순서가 올바라야 하고, 기안자
      // 본인은 결재선 어느 단계에도 들어갈 수 없습니다(셀프 승인 차단).
      function isValidAuthorWrite(d) {
        return d.authorUid == request.auth.uid
          && d.status == 'Waiting'
          && d.get('currentApproverUid', null) != request.auth.uid
          && (d.bucket == 'drafted'
              || (d.approverSeq is list
                  && d.approverSeq.size() > 0
                  && !(request.auth.uid in d.approverSeq)
                  && d.step == 0
                  && d.currentApproverUid == d.approverSeq[0]
                  && d.currentApproverUid != ''));
      }

      // 현재 결재자의 승인/반려가 결재 순서를 지키는지. approverSeq가 없는
      // 구 문서는 순서를 검증할 근거가 없어 상태 값만 확인합니다.
      function isValidTransition() {
        let next = request.resource.data;
        let seq = resource.data.get('approverSeq', null);
        return !('approverSeq' in resource.data)
            ? next.status in ['In Progress', 'Approved', 'Rejected']
            : ((next.status == 'Rejected'
                && next.currentApproverUid == null
                && next.get('step', 0) == resource.data.get('step', 0))
              || (next.status == 'Approved'
                && resource.data.step == seq.size() - 1
                && next.currentApproverUid == null
                && next.step == resource.data.step)
              || (next.status == 'In Progress'
                && resource.data.step < seq.size() - 1
                && next.step == resource.data.step + 1
                && next.currentApproverUid == seq[resource.data.step + 1]
                && next.currentApproverUid != ''));
      }

      allow read: if isAdmin() || (isMember() && isApprovalMember());
      allow create: if isMember() && isValidAuthorWrite(request.resource.data);
      allow update: if isAdmin()
        || (isMember()
            && resource.data.authorUid == request.auth.uid
            && resource.data.bucket == 'drafted'
            && isValidAuthorWrite(request.resource.data))
        // currentApproverUid 본인이어도 그게 기안자 자신이면 결재할 수
        // 없습니다. 임시저장 문서도 currentApproverUid가 채워져 있지만 아직
        // 상신 전이라 결재 대상이 아닙니다.
        || (isMember()
            && resource.data.bucket != 'drafted'
            && resource.data.status in ['Waiting', 'In Progress']
            && resource.data.currentApproverUid == request.auth.uid
            && resource.data.currentApproverUid != resource.data.authorUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'line', 'currentApproverUid', 'step'])
            && isValidTransition());
      allow delete: if isAdmin()
        || (isMember() && resource.data.authorUid == request.auth.uid);

      /* 결재 의견 — approvals/{no}/comments/{cid} (notices/tasks 댓글과 동일
         패턴으로 분리). 예전엔 comments가 approvals 문서의 배열 필드라
         "이 문서와 관련 있는 사람이면 쓰기 허용"으로만 막아뒀던 탓에,
         결재선에 있는 아무나(작성자 아닌 사람 포함) 배열째로 덮어써 남의
         의견을 고치거나 지울 수 있었습니다 — 배열 원소 단위 소유권 검증이
         규칙 문법상 불가능했기 때문. 서브컬렉션으로 옮겨 uid로 원소 단위
         권한을 검증합니다. */
      match /comments/{cid} {
        function isParentMember() {
          let ap = get(/databases/$(database)/documents/approvals/$(no)).data;
          return ap.authorUid == request.auth.uid
            || ap.currentApproverUid == request.auth.uid
            || request.auth.uid in ap.get('approverUids', []);
        }
        allow read: if isMember() && (isAdmin() || isParentMember());
        allow create: if isMember()
          && (isAdmin() || isParentMember())
          && request.resource.data.uid == request.auth.uid;
        allow update: if isMember()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isMember()
          && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }
    /* ---------------- bookings/{id} (회의실·자원 예약) ----------------
       예전엔 로그인만 하면 남의 예약도 지울 수 있었습니다. 예약자 uid
       (ownerUid)로 소유를 판정합니다 — ownerUid 가 없는 기존 예약·시드
       데이터는 관리자만 수정·취소할 수 있습니다. */
    match /bookings/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && (request.resource.data.get('ownerUid', null) == request.auth.uid
            || (isAdmin() && !('ownerUid' in request.resource.data)));
      allow update: if isAdmin()
        || (isMember()
            && resource.data.get('ownerUid', null) == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin()
        || (isMember() && resource.data.get('ownerUid', null) == request.auth.uid);
    }
    match /attendance/{uid} {
      // 본인 출퇴근 문서만
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    /* ---------------- leaves/{id} (연차·초과근무 신청) ----------------
       휴가신청서 전자결재가 최종 승인되면 그 문서번호를 그대로 id로 써서
       leaves/{id} 승인 문서를 생성해 실제 연차 잔여에 반영합니다 — 이때
       쓰는 사람은 기안자 본인이 아니라 마지막 결재자이므로, 아래 create/
       update 규칙에 isApprovedLeaveApproval() 경로를 별도로 열어둡니다. */
    match /leaves/{id} {
      // 본인 신청 또는 관리자만 조회 (목록 쿼리는 uid == 본인 으로 제한)
      allow read: if isMember()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        || (isMember()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == '대기')
        || (isMember()
            && request.resource.data.status == '승인'
            && isApprovedLeaveApproval(id, request.resource.data));
      // update는 소유자 본인 + 수정 후에도 uid가 그대로 본인이어야 함 —
      // 그렇지 않으면 본인 소유 문서를 만든 뒤 uid를 다른 직원으로 바꿔치기해
      // 그 사람 연차 잔여를 근거 없이 깎을 수 있었습니다(피해자가 자기 연차
      // 내역을 조회할 때 uid==본인 조건으로 이 위조 문서가 그대로 잡힘).
      // 또한 본인 수정은 아직 '대기'인 신청을 '대기' 그대로 고치는 것만 —
      // status 제약이 없을 땐 본인이 '대기'→'승인'으로 바꿔 셀프 승인하거나,
      // 이미 승인된 연차의 days를 0으로 고쳐(아래 delete 제한과 같은 효과를
      // update로) 잔여를 복구할 수 있었습니다. 승인/반려는 관리자 경로뿐.
      allow update: if isAdmin()
        || (isMember()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && resource.data.status == '대기'
            && request.resource.data.status == '대기');
      // 삭제(신청 취소)는 아직 '대기' 상태일 때만 — 이미 '승인'된 문서까지
      // 본인이 지울 수 있으면 연차 잔여 계산(calculateLeaveBalance)이 존재
      // 하는 문서만 합산하므로, 실제로 휴가를 쓰고도 관리자 승인/감사 기록
      // 없이 그 사용 내역을 조용히 지워 잔여를 복구할 수 있었습니다.
      allow delete: if isAdmin()
        || (isMember()
            && resource.data.uid == request.auth.uid
            && resource.data.status == '대기');
    }

    /* ---------------- sessions/{id} (접속 기기 세션) ----------------
       doc id = 브라우저별 세션ID(uid 아님) · uid 필드로 소유자 식별.
       같은 계정의 다른 기기끼리는 서로 update/delete 가능(세션 제거용). */
    match /sessions/{id} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      // delete는 uid만 확인하면 되지만(문서 자체가 사라지므로), update는
      // 수정 후에도 uid가 그대로여야 함 — 아니면 본인 세션 문서의 uid를
      // 다른 사람으로 바꿔치기해 그 사람 기기 목록에 가짜 세션을 끼워
      // 넣을 수 있었습니다.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    /* ---------------- events/{id} (캘린더 일정) ---------------- */
    match /events/{id} {
      // 워크스페이스 공용 캘린더라 로그인 사용자면 조회 가능
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.owner == request.auth.uid;
      // 생성자 본인 또는 관리자만 수정·삭제. update는 수정 후에도 owner가
      // 그대로여야 함 — 아니면 본인 일정의 owner를 다른 사람으로 바꿔
      // 소유권을 강제로 떠넘길 수 있었습니다.
      allow update: if isAdmin()
        || (isMember()
            && resource.data.owner == request.auth.uid
            && request.resource.data.owner == resource.data.owner);
      allow delete: if isAdmin()
        || (isMember() && resource.data.owner == request.auth.uid);
    }

    /* ---------------- workspace/{id} (회사 기본 정보) ---------------- */
    match /workspace/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    /* ---------------- integrationSecrets/{id} (Slack·Jandi 웹훅 URL) ----------------
       예전엔 웹훅 URL이 workspace/main(구성원 전체 열람)에 있어, 아무 직원이나
       URL을 가져가 회사 채널에 공지를 사칭한 메시지를 보낼 수 있었습니다(URL을
       바꾸기 전까지는 퇴사 후에도). 관리자만 읽고 쓰며, 알림 발송은 서버
       라우트가 Admin SDK로 읽습니다(/api/integrations/notify). */
    match /integrationSecrets/{id} {
      allow read, write: if isAdmin();
    }

    /* ---------------- chats/{chatId} (사내 메신저) ----------------
       읽기/쓰기 모두 그 방의 멤버(memberIds)만 가능. 생성 시 멤버 목록에
       본인 uid가 반드시 포함돼야 하고, memberIds는 이후 늘어날 수만
       있어야 합니다(제3자가 남을 강제로 방에서 빼는 것 방지) — 그룹에
       멤버를 초대하는 시나리오만 허용하고 축소는 막습니다. */
    match /chats/{chatId} {
      // 1:1 방 id는 항상 두 uid를 정렬해 합친 값(dmChatId — firestore.ts와
      // 동일 공식)이라 전적으로 예측 가능합니다. dm 타입 생성 시 이 id가
      // 실제로 memberIds 두 명으로부터 나온 값인지 검증하는 헬퍼.
      function dmId(a, b) {
        return a < b ? a + '_' + b : b + '_' + a;
      }

      // resource == null 분기: 1:1 방은 두 uid로 정해지는 id를 먼저
      // getDoc으로 존재 확인부터 하므로(ensureDirectChat), 아직 없는
      // 문서에 대한 read까지 허용해야 "없으면 생성" 흐름이 동작합니다
      // (없는 문서라 어차피 새어나갈 데이터가 없음).
      allow read: if isMember()
        && (resource == null || request.auth.uid in resource.data.memberIds);
      // dm 타입은 chatId가 실제로 그 두 memberIds로부터 계산된 값이어야
      // 합니다 — 이 제약이 없으면, 사내 디렉터리(누구나 조회 가능)에서 두
      // 사람의 uid만 알아도 그 둘이 나중에 주고받을 1:1 방 id를 미리 계산해
      // 제3자가 자신을 멤버로 넣은 방을 그 id로 먼저 만들어 선점할 수
      // 있었습니다 — 피해자가 "메시지" 버튼을 눌러도 이미 존재하는(제3자가
      // 낀) 방을 그대로 열게 되어 상대 없는 방에서 대화하거나 아예 접근이
      // 막힙니다.
      allow create: if isMember()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.type != 'dm'
            || (request.resource.data.memberIds.size() == 2
                && chatId == dmId(
                     request.resource.data.memberIds[0],
                     request.resource.data.memberIds[1])));
      // readAt(사용자별 안읽음 판정용 열람 시각 맵)은 본인 키만 추가/변경
      // 가능 — 그렇지 않으면 방 멤버 아무나 남의 readAt을 대신 바꿔(안읽음
      // 배지를 조작) 또는 lastMessageSenderId를 자신이 아닌 값으로 위조해
      // (실제 메시지 문서 없이 채팅 목록의 마지막 메시지 미리보기를 조작)
      // 방을 어지럽힐 수 있었습니다.
      allow update: if isMember()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.get('readAt', {})
             .diff(resource.data.get('readAt', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.get('lastMessageSenderId', null)
              == resource.data.get('lastMessageSenderId', null)
            || request.resource.data.get('lastMessageSenderId', null) == request.auth.uid);
      allow delete: if false;

      /* chats/{chatId}/messages/{messageId} */
      match /messages/{messageId} {
        allow read: if isMember()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow create: if isMember()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow update: if isMember()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId;
        allow delete: if isMember() && resource.data.senderId == request.auth.uid;
      }
    }

    /* ---------------- invites/{inviteId} ---------------- */
    match /invites/{inviteId} {
      // 초대장 문서 id == 토큰(사실상 비밀값)이라, 가입 화면은 토큰을 아는
      // 사람만 그 문서 하나를 get 할 수 있습니다. list는 관리자만 — 예전엔
      // "limit(1) 쿼리면 비로그인도 허용"이었는데, 규칙은 where 조건 값을
      // 강제할 수 없어 limit(1)+startAfter로 한 장씩 페이지를 넘기면 초대장
      // 전체(이메일·role·토큰)를 로그인 없이 훑을 수 있었습니다. 토큰을
      // 얻으면 그 이메일로 Auth 계정을 만들어(이메일 소유 확인 없음) 해당
      // role로 가입하는 것까지 가능했습니다.
      allow get: if true;
      allow list: if isAdmin();

      // 생성/삭제는 관리자만
      allow create, delete: if isAdmin();

      // 가입 완료 처리: 초대된 이메일의 당사자가 status 를 COMPLETED 로만 변경.
      // 바꿀 수 있는 필드도 완료 표시 3개로 한정 — 그렇지 않으면 같은 요청에
      // role:'SUPER_ADMIN'(또는 teamId·managerId)을 끼워 초대장 자체를 고친
      // 뒤, "role이 초대장 값과 같아야 한다"는 users create 규칙을 그대로
      // 통과해 스스로 최고 관리자로 가입할 수 있었습니다.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.status != 'COMPLETED'
            && request.auth.token.email == resource.data.email
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'completedUid', 'completedAt'])
            && request.resource.data.status == 'COMPLETED'
            && request.resource.data.completedUid == request.auth.uid);
    }
  }
}

rules_version = '2';

// CoreFlow — Firestore 보안 규칙 (참고용 기본값)
// 배포:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    /* ---------------- users/{uid} ---------------- */
    match /users/{uid} {
      // 본인 문서 또는 관리자만 조회
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // 가입 시: 본인 uid 로만 문서 생성, 권한은 스스로 승격 불가
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status in ['PENDING', 'ACTIVE'];

      // 본인은 프로필 일부만 수정, 상태/권한 변경은 관리자만
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.employeeId == resource.data.employeeId);

      allow delete: if isAdmin();
    }

    /* ---------------- 그룹웨어 공용 컬렉션 ----------------
       데모 특성상 로그인 사용자면 읽기/쓰기를 허용합니다.
       운영에서는 notices/orgPeople 쓰기를 isAdmin() 으로 좁히세요. */
    match /orgPeople/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /notices/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      /* 공지 댓글 — notices/{id}/comments/{cid} */
      match /comments/{cid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isSignedIn()
          && resource.data.uid == request.auth.uid;
      }
    }
    match /tasks/{id} {
      allow read, write: if isSignedIn();
    }
    match /approvals/{no} {
      allow read, write: if isSignedIn();
    }
    match /bookings/{id} {
      allow read, write: if isSignedIn();
    }
    match /attendance/{uid} {
      // 본인 출퇴근 문서만
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    /* ---------------- leaves/{id} (연차·초과근무 신청) ---------------- */
    match /leaves/{id} {
      // 본인 신청 또는 관리자만 조회 (목록 쿼리는 uid == 본인 으로 제한)
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.status == '대기' || isAdmin());
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    /* ---------------- sessions/{id} (접속 기기 세션) ----------------
       doc id = 브라우저별 세션ID(uid 아님) · uid 필드로 소유자 식별.
       같은 계정의 다른 기기끼리는 서로 update/delete 가능(세션 제거용). */
    match /sessions/{id} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    /* ---------------- events/{id} (캘린더 일정) ---------------- */
    match /events/{id} {
      // 워크스페이스 공용 캘린더라 로그인 사용자면 조회 가능
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.owner == request.auth.uid;
      // 생성자 본인 또는 관리자만 수정·삭제
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.owner == request.auth.uid);
    }

    /* ---------------- workspace/{id} (회사 기본 정보) ---------------- */
    match /workspace/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ---------------- invites/{inviteId} ---------------- */
    match /invites/{inviteId} {
      // 초대 토큰 검증을 위해 미인증 조회 허용 (토큰은 사실상 비밀값)
      allow get, list: if true;

      // 생성/삭제는 관리자만
      allow create, delete: if isAdmin();

      // 가입 완료 처리: 초대된 이메일의 당사자가 status 를 COMPLETED 로만 변경
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.status != 'COMPLETED'
            && request.auth.token.email == resource.data.email
            && request.resource.data.status == 'COMPLETED'
            && request.resource.data.completedUid == request.auth.uid);
    }
  }
}

rules_version = '2';

// CoreFlow — Firestore 보안 규칙 (참고용 기본값)
// 배포:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() in ['ADMIN', 'SUPER_ADMIN'];
    }

    /* 전자결재 휴가신청서(approvals/{id})가 실제로 최종 승인됐고, 그 기안자가
       uid 본인일 때만 true — leaves/{id}(문서번호를 그대로 id로 재사용) 승인
       생성을 이 사실에 근거해서만 허용하기 위한 헬퍼. 결재자(제3자)가 본인이
       아닌 uid 로 leaves 문서를 만드는 유일한 합법 경로입니다. */
    function isApprovedLeaveApproval(id, uid) {
      let ap = get(/databases/$(database)/documents/approvals/$(id));
      return ap.data.status == 'Approved'
        && ap.data.type == '휴가'
        && ap.data.authorUid == uid;
    }

    /* ---------------- users/{uid} ----------------
       조직도 · 태스크 담당자 검색 · 결재자 검색 등이 전부 이 컬렉션을 단일
       소스로 씁니다 — orgPeople 처럼 로그인 사용자면 누구나 조회 가능해야
       합니다(사내 디렉터리). 가계정(미입사)은 users/{placeholder-<random>}
       로 존재하며 관리자만 생성/삭제할 수 있습니다. */
    match /users/{uid} {
      allow get, list: if isSignedIn();

      // 가입 시: 본인 uid 로만 문서 생성, 권한은 스스로 승격 불가. teamId·
      // managerId 는 초대장에 관리자가 미리 박아둔 값과 일치해야만 통과
      // (본인이 스스로 팀/상사를 임의로 지정해 배정을 우회하는 것 방지).
      allow create: if (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status in ['PENDING', 'ACTIVE']
          && request.resource.data.teamId
             == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.teamId
          && request.resource.data.managerId
             == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.managerId)
        || (isAdmin()
            && uid.matches('^placeholder-.*')
            && request.resource.data.status == 'PLACEHOLDER');

      // 본인은 프로필 일부만 수정 — 상태/권한/사번/팀/상사 변경은 관리자만
      // (가계정 편집도 이 update 경로로 처리되며 isAdmin() 이 커버합니다)
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.employeeId == resource.data.employeeId
            && request.resource.data.teamId == resource.data.teamId
            && request.resource.data.managerId == resource.data.managerId);

      allow delete: if isAdmin();
    }

    /* ---------------- teams/{id} (부서/팀 편제) ---------------- */
    match /teams/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ---------------- 그룹웨어 공용 컬렉션 ----------------
       데모 특성상 로그인 사용자면 읽기/쓰기를 허용합니다.
       운영에서는 notices 쓰기를 isAdmin() 으로 좁히세요. */
    match /notices/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // 조회수 증가(views/unread) 처럼 본문 필드가 그대로인 갱신은 열람한
      // 아무나 보낼 수 있어야 하므로 허용하고, cat/title/body/pinned 같은
      // 실제 내용 수정·삭제는 예외 없이 작성자 본인만 가능(관리자도 불가).
      allow update: if isSignedIn()
        && (
          (request.resource.data.title == resource.data.title
            && request.resource.data.body == resource.data.body
            && request.resource.data.cat == resource.data.cat
            && request.resource.data.pinned == resource.data.pinned
            && request.resource.data.status == resource.data.status)
          || resource.data.authorUid == request.auth.uid
        );
      allow delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;

      /* 공지 댓글 — notices/{id}/comments/{cid} */
      match /comments/{cid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid;
        // 수정은 작성자 본인만. 삭제는 작성자 본인이거나 관리자/최상위
        // 관리자(admin/super_admin)도 가능 — 타인 댓글을 정리할 수 있도록.
        allow update: if isSignedIn()
          && resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
          && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }
    match /tasks/{id} {
      allow read, write: if isSignedIn();
    }
    /* ---------------- approvals/{no} (전자결재) ----------------
       승인/반려로 status·line 이 바뀌는 요청은 반드시 "현재 결재 차례"인
       사람(currentApproverUid)만 보낼 수 있습니다 — 기안자 본인이거나
       자기 차례가 아닌 사용자가 임의로 승인/반려하는 것을 서버에서 차단.
       의견 등록 등 상태에 영향 없는 갱신은 그대로 로그인 사용자면 허용. */
    match /approvals/{no} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
            && (
              (request.resource.data.status == resource.data.status
                && request.resource.data.line == resource.data.line)
              || (resource.data.currentApproverUid != null
                  && resource.data.currentApproverUid == request.auth.uid)
            ));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }
    match /bookings/{id} {
      allow read, write: if isSignedIn();
    }
    match /attendance/{uid} {
      // 본인 출퇴근 문서만
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    /* ---------------- leaves/{id} (연차·초과근무 신청) ----------------
       휴가신청서 전자결재가 최종 승인되면 그 문서번호를 그대로 id로 써서
       leaves/{id} 승인 문서를 생성해 실제 연차 잔여에 반영합니다 — 이때
       쓰는 사람은 기안자 본인이 아니라 마지막 결재자이므로, 아래 create/
       update 규칙에 isApprovedLeaveApproval() 경로를 별도로 열어둡니다. */
    match /leaves/{id} {
      // 본인 신청 또는 관리자만 조회 (목록 쿼리는 uid == 본인 으로 제한)
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == '대기')
        || (isSignedIn()
            && request.resource.data.status == '승인'
            && isApprovedLeaveApproval(id, request.resource.data.uid));
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    /* ---------------- sessions/{id} (접속 기기 세션) ----------------
       doc id = 브라우저별 세션ID(uid 아님) · uid 필드로 소유자 식별.
       같은 계정의 다른 기기끼리는 서로 update/delete 가능(세션 제거용). */
    match /sessions/{id} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    /* ---------------- events/{id} (캘린더 일정) ---------------- */
    match /events/{id} {
      // 워크스페이스 공용 캘린더라 로그인 사용자면 조회 가능
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.owner == request.auth.uid;
      // 생성자 본인 또는 관리자만 수정·삭제
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.owner == request.auth.uid);
    }

    /* ---------------- workspace/{id} (회사 기본 정보) ---------------- */
    match /workspace/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ---------------- chats/{chatId} (사내 메신저) ----------------
       읽기/쓰기 모두 그 방의 멤버(memberIds)만 가능. 생성 시 멤버 목록에
       본인 uid가 반드시 포함돼야 하고, memberIds는 이후 늘어날 수만
       있어야 합니다(제3자가 남을 강제로 방에서 빼는 것 방지) — 그룹에
       멤버를 초대하는 시나리오만 허용하고 축소는 막습니다. */
    match /chats/{chatId} {
      // resource == null 분기: 1:1 방은 두 uid로 정해지는 id를 먼저
      // getDoc으로 존재 확인부터 하므로(ensureDirectChat), 아직 없는
      // 문서에 대한 read까지 허용해야 "없으면 생성" 흐름이 동작합니다
      // (없는 문서라 어차피 새어나갈 데이터가 없음).
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.memberIds);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds.hasAll(resource.data.memberIds);
      allow delete: if false;

      /* chats/{chatId}/messages/{messageId} */
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    /* ---------------- invites/{inviteId} ---------------- */
    match /invites/{inviteId} {
      // 초대 토큰 검증을 위해 미인증 조회 허용 (토큰은 사실상 비밀값)
      allow get, list: if true;

      // 생성/삭제는 관리자만
      allow create, delete: if isAdmin();

      // 가입 완료 처리: 초대된 이메일의 당사자가 status 를 COMPLETED 로만 변경
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.status != 'COMPLETED'
            && request.auth.token.email == resource.data.email
            && request.resource.data.status == 'COMPLETED'
            && request.resource.data.completedUid == request.auth.uid);
    }
  }
}

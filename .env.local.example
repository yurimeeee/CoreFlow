# CoreFlow — Firebase 환경변수
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) 에서 값을 복사해 `.env.local` 로 저장하세요.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 선택: Google Analytics 사용 시
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 선택: 설정 > 연동 서비스 > Google Calendar / Google Drive 연동에 필요
# (두 연동이 같은 OAuth 클라이언트 ID를 공유합니다)
# 발급 방법: Google Cloud Console(console.cloud.google.com) > API 및 서비스 >
# 사용자 인증 정보 > "사용자 인증 정보 만들기" > OAuth 클라이언트 ID
# (애플리케이션 유형: 웹 애플리케이션) 생성 후,
# "승인된 자바스크립트 원본"에 이 앱의 URL(예: http://localhost:3000,
# 배포 도메인)을 추가하세요. 같은 프로젝트에서 "Google Calendar API"와
# "Google Drive API"도 사용 설정해야 합니다. Client Secret은 필요
# 없습니다(브라우저 전용 흐름).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 필수(서버 전용): Slack/Jandi 알림 발송 라우트(/api/integrations/notify)가
# 관리자만 읽을 수 있는 integrationSecrets/main 의 웹훅 URL을 읽고, 호출자의
# 로그인 토큰을 검증하는 데 씁니다. NEXT_PUBLIC_ 접두사를 붙이면 안 됩니다.
# 발급: Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"
# 으로 받은 JSON 파일 내용을 한 줄로 그대로 넣으세요.
# 비워 두면 알림이 발송되지 않습니다(라우트가 503 응답).
FIREBASE_SERVICE_ACCOUNT=

# 선택(서버 전용): 빈 프로젝트에서 첫 최고 관리자를 만들 계정 이메일.
# 이 이메일로 로그인하면 "워크스페이스 구성원이 아닙니다" 화면에
# "첫 관리자로 시작하기" 버튼이 뜹니다(FIREBASE_SERVICE_ACCOUNT 필요).
# 관리자 문서가 하나라도 생기면 더는 동작하지 않으니, 설정 후 지워도 됩니다.
BOOTSTRAP_ADMIN_EMAIL=

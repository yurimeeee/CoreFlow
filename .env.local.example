# CoreFlow — Firebase 환경변수
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) 에서 값을 복사해 `.env.local` 로 저장하세요.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 선택: Google Analytics 사용 시
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 선택: 설정 > 연동 서비스 > Google Calendar 연동에 필요
# 발급 방법: Google Cloud Console(console.cloud.google.com) > API 및 서비스 >
# 사용자 인증 정보 > "사용자 인증 정보 만들기" > OAuth 클라이언트 ID
# (애플리케이션 유형: 웹 애플리케이션) 생성 후,
# "승인된 자바스크립트 원본"에 이 앱의 URL(예: http://localhost:3000,
# 배포 도메인)을 추가하세요. 같은 프로젝트에서 "Google Calendar API"도
# 사용 설정해야 합니다. Client Secret은 필요 없습니다(브라우저 전용 흐름).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
